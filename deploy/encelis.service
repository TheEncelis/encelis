[Unit]
Description=encelis (gunicorn)
After=network.target

[Service]
User=encelis
Group=www-data
WorkingDirectory=/srv/encelis
RuntimeDirectory=encelis
RuntimeDirectoryMode=0755
# gthread workers: long AI calls do not block other requests.
ExecStart=/srv/encelis/.venv/bin/gunicorn config.wsgi:application \
    --bind unix:/run/encelis/gunicorn.sock \
    --worker-class gthread --workers 2 --threads 4 \
    --timeout 120 --graceful-timeout 30 \
    --max-requests 2000 --max-requests-jitter 200 \
    --access-logfile - --error-logfile -
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
