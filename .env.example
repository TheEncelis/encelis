# Copy to .env and fill in. Never commit the real .env.

# --- AI and email ---
DEEPSEEK_API_KEY=
RESEND_API_KEY=
DEFAULT_FROM_EMAIL=encelis <noreply@your-domain.uz>

# --- Single administrator (created/updated by `manage.py ensure_admin`) ---
ADMIN_LOGIN=admin
ADMIN_EMAIL=admin@your-domain.uz
ADMIN_PASSWORD=

# --- Django ---
# development | production
DJANGO_ENV=development
# Required in production; in development a key is generated into var/dev_secret_key
DJANGO_SECRET_KEY=
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Used to build links in emails (verification, password reset)
SITE_URL=http://localhost:8000

# --- Optional infrastructure ---
# postgres://user:password@host:5432/encelis  (SQLite in var/ when empty)
DATABASE_URL=
# redis://localhost:6379/0  (enables Celery workers and the Redis cache)
REDIS_URL=
